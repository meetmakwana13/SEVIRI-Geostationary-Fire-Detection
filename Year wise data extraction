# --- CONFIGURATION ---
# Set this to the parent directory containing the year folders (2019, 2020, etc.)
DATA_DIR = r'C:\Users\iForest.Global\OneDrive - INTERNATIONAL FORUM FOR ENVIRONMENT SCIENCE & TECHNOLOGY (iFOREST)\Desktop\sevari\15Feb_16May_2019-2026'
DATA_DIR_OUTPUT = r'C:\Users\iForest.Global\OneDrive - INTERNATIONAL FORUM FOR ENVIRONMENT SCIENCE & TECHNOLOGY (iFOREST)\Desktop\sevari\15Feb_16May_2019-2026\output_multiyear'
FILE_PATTERN = '*.NAT'

# District Shapefile
SHAPEFILE_PATH = r'C:\Users\iForest.Global\OneDrive - INTERNATIONAL FORUM FOR ENVIRONMENT SCIENCE & TECHNOLOGY (iFOREST)\Desktop\Shapefile\District Boundary\District_NWIC.shp'
DIST_COL = 'District'
STATE_COL = 'State'

# Create output directory  
if not os.path.exists(DATA_DIR_OUTPUT):
    os.makedirs(DATA_DIR_OUTPUT)

STATE_MAPPING = {'PB': 'Punjab', 'HR': 'Haryana', 'UP': 'Uttar Pradesh', 'MP': 'Madhya Pradesh'}

# Set to False to map ALL timestamps. Set to True to only use the windows below.
USE_REPORTED_WINDOWS = False

# Define "Reported" Time Windows (IST)
REPORTED_WINDOWS = [
    (time(0, 30), time(2, 30)),
    (time(10, 30), time(15, 0))
]

def is_time_reported(check_time):
    # If the toggle is off, treat every timestamp as "reported"
    if not USE_REPORTED_WINDOWS:
        return True
        
    # If the toggle is on, check against the specific windows
    for start, end in REPORTED_WINDOWS:
        if start <= check_time <= end:
            return True
    return False

def extract_cap_data(filepath):
    try:
        with open(filepath, 'rb') as f:
            content = f.read()
        eff_match = re.search(rb'<effective>(.*?)</effective>', content)
        if not eff_match: return None, []
        
        ts_str = eff_match.group(1).decode('utf-8')
        utc_ts = datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
        ist_ts = utc_ts + timedelta(hours=5, minutes=30)
        
        xml_content = content.decode('utf-8', errors='ignore')
        matches = re.findall(r'<circle>([\d\.\-,\s]+)</circle>', xml_content)
        fires = [Point(float(m.strip().split()[0].split(',')[1]), 
                       float(m.strip().split()[0].split(',')[0])) for m in matches]
        
        return utc_ts, ist_ts, fires
    except Exception as e:
        print(f"Error reading {os.path.basename(filepath)}: {e}")
        return None, None,[]

def add_satellite_annotations(ax):
    # Added (3, 'VIIRS\n01:30') for the new satellite line
    for idx, label in [(3, 'VIIRS\n01:30'), (21, 'MODIS (Terra)\n10:30'), (27, 'MODIS (Aqua), VIIRS\n13:30')]:
        ax.axvline(x=idx, color='black', linestyle='--', alpha=0.6, linewidth=1.2)
        ax.text(idx - 0.4, ax.get_ylim()[1]*0.7, label, rotation=90, 
                fontweight='bold', fontsize=11, ha='right', va='center')

def analyze_multi_year_fires():
    dist_gdf = gpd.read_file(SHAPEFILE_PATH).to_crs("EPSG:4326")
    
    excel_path = os.path.join(DATA_DIR_OUTPUT, 'Fire_Analysis_2019_to_2026.xlsx')
    
    full_range = [datetime.strptime(f"{h:02d}:{m:02d}", "%H:%M").time() for h in range(24) for m in [0, 30]]
    x_labels = [t.strftime('%H:%M') for t in full_range]
    
    # Dictionary to hold plot data: { year: { 'All': [...], 'PB': [...], ... } }
    yearly_diurnal_data = {}

    with pd.ExcelWriter(excel_path, engine='xlsxwriter') as writer:
        
        for year in range(2019, 2027):
            print(f"--- Processing Year: {year} ---")
            year_dir = os.path.join(DATA_DIR, str(year))
            
            if not os.path.exists(year_dir):
                print(f"Folder for {year} not found. Skipping.")
                continue
                
            start_date = date(year, 1, 1)
            end_date = date(year, 12, 31)
            
            files = sorted(glob.glob(os.path.join(year_dir, FILE_PATTERN)))
            all_records = []
            district_logs = []
            
            for f in files:
                utc_ts, ist_ts, fire_pts = extract_cap_data(f)
                if ist_ts is None: continue
                
                logical_date = utc_ts.date()
                
                # Apply Dynamic Date Filter
                if not (start_date <= logical_date <= end_date):
                    continue 
                
                rec = {'IST_Timestamp': ist_ts, 'Date': logical_date, 'Time': ist_ts.time()}
                
                if fire_pts:
                    fgdf = gpd.GeoDataFrame(geometry=fire_pts, crs="EPSG:4326")
                    joined = gpd.sjoin(fgdf, dist_gdf, how="inner", predicate="within")
                    
                    counts = joined[STATE_COL].value_counts()
                    for code in STATE_MAPPING.keys():
                        rec[f'{code}_Count'] = counts.get(code, 0)
                    
                    for _, row in joined.iterrows():
                        district_logs.append({
                            'Date': logical_date,
                            'Time': ist_ts.strftime('%H:%M'),
                            'State': row[STATE_COL],
                            'District': row[DIST_COL],
                            'Fire_Count': 1
                        })
                else:
                    for code in STATE_MAPPING.keys(): rec[f'{code}_Count'] = 0
                    
                all_records.append(rec)

            if not all_records: 
                print(f"No fire data found for {year}.")
                continue

            df = pd.DataFrame(all_records)
            df_dist = pd.DataFrame(district_logs)

            # Gather Statistical Summary
            summary_data = []
            for code, full_name in STATE_MAPPING.items():
                col = f'{code}_Count'
                if df[col].sum() == 0: continue
                
                state_activity = df[df[col] > 0].copy()
                total_fires = df[col].sum()
                
                hourly_series = df.groupby(df['IST_Timestamp'].dt.floor('30min').dt.time)[col].sum()
                peak_hour = hourly_series.idxmax().strftime('%H:%M')
                earliest = state_activity['Time'].min()
                
                reported_fires = sum(row[col] for _, row in df.iterrows() if is_time_reported(row['Time']))
                unreported_pct = ((total_fires - reported_fires) / total_fires) * 100
                
                summary_data.append({
                    'State': full_name, 'Total Fires': total_fires,
                    'Earliest Detection': earliest, 'Peak Fire Hour': peak_hour,
                    'Unreported Data (%)': f"{unreported_pct:.2f}%"
                })

            df_summary = pd.DataFrame(summary_data)

            # Export to Excel Sheets (Names shortened slightly to meet Excel's 31 char limit)
            df_sheet1 = df.copy()
            df_sheet1['IST_Timestamp'] = df_sheet1['IST_Timestamp'].dt.tz_localize(None)
            cols = ['Date', 'Time'] + [c for c in df_sheet1.columns if 'Count' in c]
            
            df_sheet1[cols].to_excel(writer, sheet_name=f'{year}_Trend', index=False)
            df_summary.to_excel(writer, sheet_name=f'{year}_Summary', index=False)
            if not df_dist.empty:
                df_dist_final = df_dist.groupby(['State', 'District', 'Date', 'Time']).sum().reset_index()
                df_dist_final.to_excel(writer, sheet_name=f'{year}_Dist', index=False)

            # Store Data for Multi-Year Plotting
            df['Time_IST'] = df['IST_Timestamp'].dt.floor('30min').dt.time
            yearly_diurnal_data[year] = {}
            
            # 1. Total across all states
            state_cols = [f'{code}_Count' for code in STATE_MAPPING.keys()]
            df['Total_Count'] = df[state_cols].sum(axis=1)
            yearly_diurnal_data[year]['All'] = df.groupby('Time_IST')['Total_Count'].sum().reindex(full_range, fill_value=0).values
            
            # 2. Individual states
            for code in STATE_MAPPING.keys():
                yearly_diurnal_data[year][code] = df.groupby('Time_IST')[f'{code}_Count'].sum().reindex(full_range, fill_value=0).values

    # --- MULTI-YEAR PLOTTING ---
    if yearly_diurnal_data:
        print("\nGenerating Multi-Year Trend Graphs...")
        # Define visually distinct colors for each year
        year_colors = {y: plt.cm.tab10(i) for i, y in enumerate(yearly_diurnal_data.keys())}
        
        # Plot categories: 'All' (Combined) + each individual state
        plot_categories = ['All'] + list(STATE_MAPPING.keys())
        
        for category in plot_categories:
            fig, ax = plt.subplots(figsize=(18, 9))
            has_data = False
            
            for year, year_data in yearly_diurnal_data.items():
                y_values = year_data[category]
                if sum(y_values) > 0: # Only plot if there were fires that year
                    ax.plot(range(len(full_range)), y_values, marker='o', markersize=4, linewidth=2, 
                            label=str(year), color=year_colors[year])
                    has_data = True
            
            if has_data:
                add_satellite_annotations(ax)
                ax.set_xticks(range(len(full_range)))
                ax.set_xticklabels(x_labels, rotation=90, fontsize=14)
                
                title_suffix = "All Targeted States Combined" if category == 'All' else STATE_MAPPING[category]
                ax.set_title(f"Reporting Trend (2019-2026): Diurnal Cycle - {title_suffix}", fontsize=16, fontweight='bold')
                ax.set_ylabel("Total Fire Count", fontsize=14)
                ax.grid(axis='y', linestyle='--', alpha=0.5)
                ax.legend(loc='upper right', title="Year", title_fontsize='13', fontsize='12')
                
                plt.tight_layout()
                plt.savefig(os.path.join(DATA_DIR_OUTPUT, f'MultiYear_Trend_{category}.png'), dpi=200)
            plt.close()

    print(f"Success! Analysis complete. Files saved in: {DATA_DIR_OUTPUT}")

if __name__ == "__main__":
    analyze_multi_year_fires()
